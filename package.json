{
  "name": "certifica-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc -b && vite build",
