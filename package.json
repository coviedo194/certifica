  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
